# Copia este archivo como .env y rellena los valores.

# PostgreSQL (Neon): postgresql://usuario:clave@host.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=""

ADMIN_EMAIL="tu-correo@ejemplo.com"
ADMIN_PASSWORD="una-clave-segura"
ADMIN_NAME="Tu Nombre"

# ── Opcional: resumen diario por WhatsApp (gratis, CallMeBot) ──────────────────
# Autoriza una vez enviando "I allow callmebot to send me messages" al
# +34 644 51 95 23; te responden con tu apikey.
CALLMEBOT_PHONE=""    # tu número con lada, solo dígitos. Ej. 5215512345678
CALLMEBOT_APIKEY=""   # la apikey que te da CallMeBot
# Secreto para que solo el Cron de Vercel dispare el envío automático.
# Genera con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""

# ── Opcional: respaldo automático por correo (gratis, Resend) ─────────────────
# Crea una cuenta en https://resend.com con TU correo y genera una API key.
RESEND_API_KEY=""     # la apikey de Resend
BACKUP_EMAIL=""       # correo donde recibir el respaldo (el mismo de tu cuenta Resend)

# ── Opcional: respaldo automático a Google Drive (gratis, Apps Script) ─────────
# Publica el Apps Script como app web (queda en TU Drive) y pega aquí su URL.
DRIVE_WEBHOOK_URL=""   # la URL /exec que te da Apps Script al publicar
# Un secreto que tú inventas y pegas TAMBIÉN dentro del script (campo TOKEN).
# Genera con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DRIVE_WEBHOOK_TOKEN=""
